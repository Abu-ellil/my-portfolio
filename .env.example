# Contact form → Telegram relay
# Form data is POSTed to the serverless function api/contact.js, which runs on
# the Vercel mirror. The function reads TELEGRAM_BOT_TOKEN / TELEGRAM_CHAT_ID
# from VERCEL environment variables (set them in the Vercel dashboard or CLI —
# they must never live in this repo or the client bundle).
#
# Optional: override the relay endpoint (default: the Vercel mirror below).
REACT_APP_CONTACT_API_URL=https://mahmoud-abuellil.vercel.app/api/contact
